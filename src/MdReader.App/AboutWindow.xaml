<Window x:Class="MdReader.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About mdreader" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="mdreader" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Text="version" Opacity="0.65" Margin="0,2,0,12"/>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="A fast, beautiful markdown reader for Windows — that happens to edit."/>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Opacity="0.8"
                   Text="Free and open source under the MIT license. No telemetry. Ever."/>

        <TextBlock Margin="0,4,0,0">
            <Run Text="By "/>
            <Hyperlink Click="OnCompanyLinkClick" ToolTip="https://recherchesolutions.com">Recherche Solutions LLC</Hyperlink>
        </TextBlock>

        <Button Content="OK" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
                Padding="20,4" Margin="0,18,0,0" Click="OnOkClick"/>
    </StackPanel>
</Window>
