<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MdReader.App</RootNamespace>
    <AssemblyName>mdreader</AssemblyName>
    <ApplicationIcon>Assets\mdreader.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Custom Main: fast version flag and pre-WPF single-instance handoff. -->
    <StartupObject>MdReader.App.Program</StartupObject>
    <Description>mdreader — a fast, beautiful markdown reader for Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MdReader.Core\MdReader.Core.csproj" />
    <ProjectReference Include="..\MdReader.Shell\MdReader.Shell.csproj" />
  </ItemGroup>

  <!-- Document icon for the .md file association, shipped beside the exe so
       DefaultIcon registry values can reference it directly. -->
  <ItemGroup>
    <None Include="Assets\mdreader-doc.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Bundle all web assets (reader.html, editor.html, css, js, vendor libs) beside the exe. -->
  <ItemGroup>
    <None Include="..\MdReader.Web\**\*" Exclude="..\MdReader.Web\**\node_modules\**">
      <Link>Web\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

</Project>
