<Window x:Class="MdReader.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — mdreader" Width="560" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <DockPanel Margin="0">
        <Border DockPanel.Dock="Bottom" BorderBrush="#30808080" BorderThickness="0,1,0,0" Padding="12,10">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Opacity="0.6"
                           Text="mdreader has no telemetry. Ever."/>
                <Button DockPanel.Dock="Right" Padding="16,4" Margin="8,0,0,0" IsCancel="True">Cancel</Button>
                <Button DockPanel.Dock="Right" Padding="16,4" FontWeight="SemiBold" IsDefault="True" Click="OnSaveClick">Save</Button>
            </DockPanel>
        </Border>

        <TabControl Margin="10">
            <TabItem Header="General">
                <StackPanel Margin="14">
                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,6">Opening documents</TextBlock>
                    <DockPanel Margin="0,2">
                        <TextBlock Width="170" VerticalAlignment="Center">Default mode</TextBlock>
                        <ComboBox x:Name="DefaultModeBox" Width="180" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <CheckBox x:Name="SplitDefaultBox" Margin="170,6,0,0">Open in split view by default</CheckBox>

                    <TextBlock FontWeight="SemiBold" Margin="0,18,0,6">Appearance</TextBlock>
                    <DockPanel Margin="0,2">
                        <TextBlock Width="170" VerticalAlignment="Center">Theme</TextBlock>
                        <ComboBox x:Name="ThemeBox" Width="180" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,2">
                        <TextBlock Width="170" VerticalAlignment="Center">Custom theme CSS</TextBlock>
                        <ComboBox x:Name="CustomThemeBox" Width="180" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <TextBlock Margin="170,2,0,0" Opacity="0.6" FontSize="11" TextWrapping="Wrap">
                        Drop .css files into %APPDATA%\mdreader\themes\ and they appear here.
                    </TextBlock>
                    <DockPanel Margin="0,8,0,2">
                        <TextBlock Width="170" VerticalAlignment="Center">Content width</TextBlock>
                        <ComboBox x:Name="ContentWidthBox" Width="180" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <TextBlock Margin="170,2,0,0" Opacity="0.6" FontSize="11" TextWrapping="Wrap">
                        Full width follows the window; 720 px is the classic ~75-character reading measure.
                    </TextBlock>
                    <DockPanel Margin="0,8,0,2">
                        <TextBlock Width="170" VerticalAlignment="Center">Font family override</TextBlock>
                        <TextBox x:Name="FontFamilyBox" Width="180" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,2">
                        <TextBlock Width="170" VerticalAlignment="Center">Font size override (px)</TextBlock>
                        <TextBox x:Name="FontSizeBox" Width="60" HorizontalAlignment="Left"/>
                    </DockPanel>

                    <TextBlock FontWeight="SemiBold" Margin="0,18,0,6">Files</TextBlock>
                    <DockPanel Margin="0,2">
                        <TextBlock Width="170" VerticalAlignment="Center">Line endings on save</TextBlock>
                        <ComboBox x:Name="LineEndingBox" Width="180" HorizontalAlignment="Left"/>
                    </DockPanel>

                    <TextBlock FontWeight="SemiBold" Margin="0,18,0,6">Privacy</TextBlock>
                    <CheckBox x:Name="RemoteImagesBox">Load remote images in all documents (tracking risk)</CheckBox>
                    <CheckBox x:Name="UpdateCheckBox" Margin="0,6,0,0">Check GitHub for new releases at startup (opt-in)</CheckBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="File associations">
                <StackPanel Margin="14">
                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,6">Registered extensions</TextBlock>
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8">
                        .md and .markdown are always registered. Opt into the rest:
                    </TextBlock>
                    <ItemsControl x:Name="ExtensionList"/>

                    <TextBlock FontWeight="SemiBold" Margin="0,18,0,6">Current owners</TextBlock>
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8">
                        Which app each extension currently opens with (the user choice recorded by Windows):
                    </TextBlock>
                    <ItemsControl x:Name="OwnersList" FontFamily="Consolas" FontSize="12"/>

                    <Button x:Name="SetDefaultButton" HorizontalAlignment="Left" Padding="12,4" Margin="0,16,0,0"
                            Click="OnSetDefaultClick">Set mdreader as the default app…</Button>
                    <TextBlock Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                        This opens the standard Windows dialog — the choice is always yours to make there.
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
