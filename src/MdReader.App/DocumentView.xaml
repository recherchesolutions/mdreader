<UserControl x:Class="MdReader.App.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Non-modal file-changed bar (live reload while dirty) -->
        <Border x:Name="ReloadBar" Grid.Row="0" Visibility="Collapsed"
                Background="#FFF4E5" BorderBrush="#E0C285" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="This file changed on disk while you have unsaved edits."/>
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,2" Click="OnKeepMineClick">Keep mine</Button>
                <Button DockPanel.Dock="Right" Padding="10,2" Click="OnReloadClick">Reload</Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" x:Name="ViewGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="0"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="ReaderColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <wv2:WebView2 x:Name="EditorView" Grid.Column="0" Visibility="Collapsed"
                          DefaultBackgroundColor="Transparent"/>
            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="4" Visibility="Collapsed"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#40808080"/>
            <wv2:WebView2 x:Name="ReaderView" Grid.Column="2"
                          DefaultBackgroundColor="Transparent"/>
        </Grid>
    </Grid>
</UserControl>
