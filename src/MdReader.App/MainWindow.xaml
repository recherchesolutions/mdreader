<Window x:Class="MdReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mdreader" Width="1100" Height="800"
        AllowDrop="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <!-- Restrained command-bar buttons: flat, subtle hover, MDL2 glyphs. -->
            <Style x:Key="CmdButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#20808080"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CmdTextButton" TargetType="Button" BasedOn="{StaticResource CmdButton}">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </Grid.Resources>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Click="OnOpenClick"/>
                <MenuItem x:Name="RecentMenu" Header="Open _Recent"/>
                <Separator/>
                <MenuItem x:Name="SaveMenuItem" Header="_Save" InputGestureText="Ctrl+S" Click="OnSaveClick"/>
                <Separator/>
                <MenuItem x:Name="ExportMenu" Header="_Export">
                    <MenuItem Header="Export to _HTML…" Click="OnExportHtmlClick"/>
                    <MenuItem Header="Export to _PDF…" Click="OnExportPdfClick"/>
                </MenuItem>
                <MenuItem Header="_Print…" InputGestureText="Ctrl+P" Click="OnPrintClick"/>
                <MenuItem Header="Copy as _Rich Text" Click="OnCopyRichTextClick"/>
                <Separator/>
                <MenuItem Header="Close _Tab" InputGestureText="Ctrl+W" Click="OnCloseTabClick"/>
                <MenuItem Header="E_xit" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ReaderModeItem" Header="_Reader" InputGestureText="Ctrl+E" Click="OnReaderModeClick"/>
                <MenuItem x:Name="SourceModeItem" Header="_Source" InputGestureText="Ctrl+E" Click="OnSourceModeClick"/>
                <MenuItem x:Name="SplitModeItem" Header="Sp_lit" InputGestureText="Ctrl+Shift+E" Click="OnSplitModeClick"/>
                <Separator/>
                <MenuItem x:Name="TocItem" Header="Table of _Contents" InputGestureText="Ctrl+Shift+O" Click="OnTocClick"/>
                <Separator/>
                <MenuItem Header="Zoom _In" InputGestureText="Ctrl+Plus" Click="OnZoomInClick"/>
                <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+Minus" Click="OnZoomOutClick"/>
                <MenuItem Header="_Reset Zoom" InputGestureText="Ctrl+0" Click="OnZoomResetClick"/>
                <Separator/>
                <MenuItem Header="_Theme">
                    <MenuItem x:Name="ThemeSystemItem" Header="_System" IsCheckable="True" Click="OnThemeSystemClick"/>
                    <MenuItem x:Name="ThemeLightItem" Header="_Light" IsCheckable="True" Click="OnThemeLightClick"/>
                    <MenuItem x:Name="ThemeDarkItem" Header="_Dark" IsCheckable="True" Click="OnThemeDarkClick"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Settings…" Click="OnSettingsClick"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About mdreader" Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <!-- Compact command bar: the common actions, one restrained row. -->
        <Border x:Name="CommandBar" Grid.Row="1" BorderBrush="#30808080" BorderThickness="0,0,0,1" Padding="6,3">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource CmdButton}" Content="&#xE8E5;" Click="OnOpenClick"
                            ToolTip="Open (Ctrl+O)" AutomationProperties.Name="Open file"/>
                    <Separator Width="1" Margin="4,4" Background="#30808080"/>
                    <Button x:Name="BackButton" Style="{StaticResource CmdButton}" Content="&#xE72B;" Click="OnBackClick"
                            ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back"/>
                    <Button x:Name="ForwardButton" Style="{StaticResource CmdButton}" Content="&#xE72A;" Click="OnForwardClick"
                            ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward"/>
                    <Separator Width="1" Margin="4,4" Background="#30808080"/>
                    <Button x:Name="ReaderButton" Style="{StaticResource CmdTextButton}" Content="Reader" Click="OnReaderModeClick"
                            ToolTip="Reader mode (Ctrl+E)" AutomationProperties.Name="Reader mode"/>
                    <Button x:Name="SourceButton" Style="{StaticResource CmdTextButton}" Content="Source" Click="OnSourceModeClick"
                            ToolTip="Source mode (Ctrl+E)" AutomationProperties.Name="Source mode"/>
                    <Button x:Name="SplitButton" Style="{StaticResource CmdTextButton}" Content="Split" Click="OnSplitModeClick"
                            ToolTip="Split view (Ctrl+Shift+E)" AutomationProperties.Name="Split view"/>
                    <Separator Width="1" Margin="4,4" Background="#30808080"/>
                    <Button x:Name="TocButton" Style="{StaticResource CmdButton}" Content="&#xE8FD;" Click="OnTocClick"
                            ToolTip="Table of contents (Ctrl+Shift+O)" AutomationProperties.Name="Table of contents"/>
                    <Button Style="{StaticResource CmdButton}" Content="&#xE721;" Click="OnFindToolbarClick"
                            ToolTip="Find (Ctrl+F)" AutomationProperties.Name="Find"/>
                </StackPanel>
                <StackPanel x:Name="CommandBarRight" Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource CmdTextButton}" Content="Export HTML" Click="OnExportHtmlClick"
                            AutomationProperties.Name="Export to HTML"/>
                    <Button Style="{StaticResource CmdTextButton}" Content="Export PDF" Click="OnExportPdfClick"
                            AutomationProperties.Name="Export to PDF"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- First-run default-app suggestion bar (non-modal, dismissible) -->
        <Border x:Name="DefaultAppBar" Grid.Row="2" Visibility="Collapsed"
                Background="#E7F1FB" BorderBrush="#B5CFEA" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="Make mdreader the default app for Markdown files?"/>
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,2" Click="OnDefaultAppDontAskClick">Don't ask again</Button>
                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,2" Click="OnDefaultAppNotNowClick">Not now</Button>
                <Button DockPanel.Dock="Right" Padding="10,2" FontWeight="SemiBold" Click="OnDefaultAppSetClick">Set as default</Button>
            </DockPanel>
        </Border>

        <!-- Find bar -->
        <Border x:Name="FindBar" Grid.Row="3" Visibility="Collapsed"
                BorderBrush="#40808080" BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel LastChildFill="False">
                <TextBox x:Name="FindBox" DockPanel.Dock="Left" Width="260" VerticalContentAlignment="Center"
                         KeyDown="OnFindBoxKeyDown" TextChanged="OnFindTextChanged"/>
                <TextBlock x:Name="FindCount" DockPanel.Dock="Left" Margin="10,0" VerticalAlignment="Center"
                           Foreground="Gray" Text=""/>
                <Button DockPanel.Dock="Left" Padding="8,2" Click="OnFindPrevClick" ToolTip="Previous (Shift+Enter)">▲</Button>
                <Button DockPanel.Dock="Left" Margin="4,0,0,0" Padding="8,2" Click="OnFindNextClick" ToolTip="Next (Enter)">▼</Button>
                <CheckBox x:Name="FindMatchCase" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                          Content="Match case" Checked="OnFindTextChanged" Unchecked="OnFindTextChanged"/>
                <Button DockPanel.Dock="Right" Padding="8,2" Click="OnFindCloseClick" ToolTip="Close (Esc)">✕</Button>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4">
            <!-- Hidden 0x0 host where WebViewPool pre-warms the next reader. -->
            <Canvas x:Name="WebViewWarmHost" Width="0" Height="0"
                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TabControl x:Name="Tabs" Visibility="Collapsed" SelectionChanged="OnTabSelectionChanged"/>

            <!-- Empty state: recent files -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="mdreader" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.85"/>
                <TextBlock Text="Open a markdown file to start reading." Margin="0,6,0,18"
                           HorizontalAlignment="Center" Opacity="0.6"/>
                <Button Content="Open file…  (Ctrl+O)" Padding="16,6" HorizontalAlignment="Center" Click="OnOpenClick"/>
                <TextBlock x:Name="RecentHeader" Text="Recent" FontWeight="SemiBold" Margin="0,24,0,6" Visibility="Collapsed"/>
                <ItemsControl x:Name="RecentList"/>
            </StackPanel>
        </Grid>

        <StatusBar Grid.Row="5">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatsText" Text="" Margin="0,0,16,0" Opacity="0.7"
                               AutomationProperties.Name="Reading statistics"/>
                    <TextBlock x:Name="ZoomStatus" Text="100%" Margin="0,0,16,0" Opacity="0.7"/>
                    <Button x:Name="ModeButton" Padding="10,1" Click="OnModeButtonClick" Content="Reader"
                            ToolTip="Toggle Reader / Source (Ctrl+E)"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
